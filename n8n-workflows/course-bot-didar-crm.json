{
  "name": "Course Bot - Didar CRM",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "course-bot",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {}
      }
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "\nconst CONFIG = {\n  WEBHOOK_SECRET: 'YOUR_WEBHOOK_SECRET_HERE',\n  DIDAR_API_KEY: 'YOUR_DIDAR_API_KEY_HERE',\n  OWNER_ID: 'YOUR_OWNER_GUID_HERE',\n  PIPELINE_ID: 'YOUR_PIPELINE_GUID_HERE',\n  COMPANY_ID: '00000000-0000-0000-0000-000000000000',\n  ACTIVITY_TYPE_SALES: 'YOUR_SALES_ACTIVITY_TYPE_GUID',\n  ACTIVITY_TYPE_FOLLOWUP: 'YOUR_FOLLOWUP_ACTIVITY_TYPE_GUID',\n  STAGES: {\n    register: 'STAGE_GUID_HERE',\n    lesson_1: 'STAGE_GUID_HERE', lesson_2: 'STAGE_GUID_HERE',\n    lesson_3: 'STAGE_GUID_HERE', lesson_4: 'STAGE_GUID_HERE',\n    lesson_5: 'STAGE_GUID_HERE', lesson_6: 'STAGE_GUID_HERE',\n    lesson_7: 'STAGE_GUID_HERE', lesson_8: 'STAGE_GUID_HERE',\n    sales_wait: 'STAGE_GUID_HERE',\n    followup_1: 'STAGE_GUID_HERE', followup_2: 'STAGE_GUID_HERE',\n    followup_3: 'STAGE_GUID_HERE'\n  },\n  CUSTOM_FIELDS: {\n    monthly_income: 'FIELD_GUID', staff_count: 'FIELD_GUID',\n    job: 'FIELD_GUID', best_call_time: 'FIELD_GUID',\n    lead_score: 'FIELD_GUID', city: 'FIELD_GUID',\n    income_class: 'FIELD_GUID'\n  }\n};\nconst body = $input.first().json.body || $input.first().json;\nconst event = body.event || {};\nconst user = body.user || {};\nconst course = body.course || {};\nconst lesson = body.lesson || {};\nconst progress = body.progress || {};\nconst payload = body.payload || {};\nconst action = event.action || '';\nreturn [{json: {...body, CONFIG, action,\n  user_phone: user.phone || '',\n  user_name: (user.first_name||'') + ' ' + (user.last_name||''),\n  course_title: course.title || '',\n  lesson_title: lesson.title || '',\n  lesson_order: lesson.order || 0,\n  progress_percent: progress.percent || 0,\n  progress_completed: progress.completed || 0,\n  progress_total: progress.total || 0\n}}];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "router",
      "name": "Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        750,
        300
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.action}}",
        "rules": {
          "rules": [
            {
              "value2": "lead.register",
              "output": 0
            },
            {
              "value2": "lesson.complete",
              "output": 1
            },
            {
              "value2": "form.submit",
              "output": 2
            },
            {
              "value2": "quiz.pass",
              "output": 3
            },
            {
              "value2": "quiz.fail",
              "output": 4
            },
            {
              "value2": "inactivity.timeout",
              "output": 5
            },
            {
              "value2": "course.complete",
              "output": 6
            },
            {
              "value2": "speed.change",
              "output": 7
            }
          ]
        },
        "fallbackOutput": -1
      }
    },
    {
      "id": "prep_register",
      "name": "Prep Register",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        50
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nconst lastName=d.user?.last_name||d.user?.first_name||'User';\nreturn [{json:{phone:d.user_phone,firstName:d.user?.first_name||'',lastName,\nownerId:C.OWNER_ID,pipelineId:C.PIPELINE_ID,stageId:C.STAGES.register,\ncompanyId:C.COMPANY_ID,activityTypeId:C.ACTIVITY_TYPE_SALES,\ncourseTitle:d.course_title,dealTitle:'دوره '+d.course_title+' - '+lastName,CONFIG:C}}];\n"
      }
    },
    {
      "id": "find_person",
      "name": "Find Person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1300,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/contact/getbyphonenumber?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"MobilePhone\":\"{{$json.phone}}\"}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "process_person",
      "name": "Process Person",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1550,
        50
      ],
      "parameters": {
        "jsCode": "\nconst prev=$('Prep Register').first().json;\nconst resp=$input.first().json;\nconst found=resp?.body?.Response?.Id||resp?.Response?.Id||null;\nreturn [{json:{...prev,personExists:!!found,personId:found||null}}];\n"
      }
    },
    {
      "id": "create_person",
      "name": "Create Person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1800,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/contact/save?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Contact\":{\"Type\":\"Person\",\"FirstName\":\"{{$json.firstName}}\",\"LastName\":\"{{$json.lastName}}\",\"MobilePhone\":\"{{$json.phone}}\",\"OwnerId\":\"{{$json.ownerId}}\",\"CompanyId\":\"{{$json.companyId}}\",\"VisibilityType\":\"Owner\"}}",
        "options": {}
      }
    },
    {
      "id": "get_person_id",
      "name": "Get Person ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2050,
        50
      ],
      "parameters": {
        "jsCode": "\nconst prev=$('Process Person').first().json;\nconst resp=$input.first().json;\nconst newId=resp?.body?.Response?.Id||resp?.Response?.Id||'';\nreturn [{json:{...prev,personId:prev.personId||newId}}];\n"
      }
    },
    {
      "id": "create_deal",
      "name": "Create Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        2300,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/deal/save_v2?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Deal\":{\"Title\":\"{{$json.dealTitle}}\",\"OwnerId\":\"{{$json.ownerId}}\",\"PersonId\":\"{{$json.personId}}\",\"CompanyId\":\"{{$json.companyId}}\",\"PipelineId\":\"{{$json.pipelineId}}\",\"PipelineStageId\":\"{{$json.stageId}}\",\"Status\":\"Open\",\"VisibilityType\":\"Owner\"}}",
        "options": {}
      }
    },
    {
      "id": "happy_call",
      "name": "Happy Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        2550,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/activity/save?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Activity\":{\"Title\":\"تماس خوشامدگویی - {{$json.lastName}}\",\"ActivityTypeId\":\"{{$json.activityTypeId}}\",\"OwnerId\":\"{{$json.ownerId}}\",\"IsDone\":false,\"ContactIds\":[\"{{$json.personId}}\"],\"Note\":\"ثبت نام جدید در دوره {{$json.courseTitle}}\"}}",
        "options": {}
      }
    },
    {
      "id": "prep_lesson",
      "name": "Prep Lesson",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        250
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nconst stageId=C.STAGES['lesson_'+d.lesson_order]||'';\nreturn [{json:{phone:d.user_phone,stageId,lessonOrder:d.lesson_order,\ncourseTitle:d.course_title,ownerId:C.OWNER_ID,pipelineId:C.PIPELINE_ID,\nnoteText:'درس '+d.lesson_order+' ('+d.lesson_title+') تکمیل - '+d.progress_percent+'%',CONFIG:C}}];\n"
      }
    },
    {
      "id": "find_deal",
      "name": "Find Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1300,
        250
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/deal/search_v2?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Criteria\":{\"Keywords\":\"{{$json.courseTitle}}\",\"PipelineId\":\"{{$json.pipelineId}}\",\"Status\":\"Open\"},\"From\":0,\"Limit\":5}",
        "options": {}
      }
    },
    {
      "id": "update_stage",
      "name": "Update Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1550,
        250
      ],
      "parameters": {
        "jsCode": "\nconst prev=$('Prep Lesson').first().json;\nconst resp=$input.first().json;\nconst deals=resp?.body?.Response?.List||resp?.Response?.List||[];\nif(!deals.length) return [{json:{skip:true}}];\nconst deal=deals[0];\nreturn [{json:{dealId:deal.Id,dealTitle:deal.Title,personId:deal.PersonId,\nstageId:prev.stageId,ownerId:prev.ownerId,pipelineId:prev.pipelineId,\ncompanyId:deal.CompanyId||'00000000-0000-0000-0000-000000000000',\nnoteText:prev.noteText,CONFIG:prev.CONFIG}}];\n"
      }
    },
    {
      "id": "prep_form",
      "name": "Prep Form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        450
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nconst f=d.payload?.form_responses||{};\nconst map={monthly_income:C.CUSTOM_FIELDS.monthly_income,staff_count:C.CUSTOM_FIELDS.staff_count,\njob:C.CUSTOM_FIELDS.job,best_call_time:C.CUSTOM_FIELDS.best_call_time,\ncity:C.CUSTOM_FIELDS.city,income_class:C.CUSTOM_FIELDS.income_class};\nlet cf=[];\nfor(const[k,g] of Object.entries(map)){if(f[k]&&g)cf.push({FieldId:g,Value:String(f[k])});}\nreturn [{json:{phone:d.user_phone,customFields:JSON.stringify(cf),CONFIG:C}}];\n"
      }
    },
    {
      "id": "prep_quiz_pass",
      "name": "Prep Quiz Pass",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        600
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nconst qr=d.payload?.quiz_result||{};\nreturn [{json:{phone:d.user_phone,ownerId:C.OWNER_ID,CONFIG:C,\nnoteText:'کوییز پاس! نمره:'+qr.score+'/'+qr.passing_score+' درس:'+d.lesson_title}}];\n"
      }
    },
    {
      "id": "prep_quiz_fail",
      "name": "Prep Quiz Fail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        750
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nconst qr=d.payload?.quiz_result||{};\nreturn [{json:{phone:d.user_phone,ownerId:C.OWNER_ID,CONFIG:C,\nnoteText:'کوییز ناموفق! نمره:'+qr.score+'/'+qr.passing_score+' درس:'+d.lesson_title}}];\n"
      }
    },
    {
      "id": "prep_inactivity",
      "name": "Prep Inactivity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        900
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nreturn [{json:{phone:d.user_phone,ownerId:C.OWNER_ID,CONFIG:C,\nactivityTypeId:C.ACTIVITY_TYPE_FOLLOWUP,\nactivityTitle:'پیگیری عدم فعالیت - '+d.user_name,\nactivityNote:'غیرفعال 48+ ساعت. درس آخر:'+d.lesson_title+' پیشرفت:'+d.progress_percent+'%'}}];\n"
      }
    },
    {
      "id": "prep_complete",
      "name": "Prep Complete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        1050
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nreturn [{json:{phone:d.user_phone,userName:d.user_name,courseTitle:d.course_title,\nstageId:C.STAGES.sales_wait,ownerId:C.OWNER_ID,pipelineId:C.PIPELINE_ID,\nactivityTypeId:C.ACTIVITY_TYPE_SALES,CONFIG:C,\nnoteText:'دوره '+d.course_title+' تکمیل شد!',\nactivityTitle:'تماس فروش - '+d.user_name}}];\n"
      }
    },
    {
      "id": "prep_speed",
      "name": "Prep Speed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        1200
      ],
      "parameters": {
        "jsCode": "\nconst d=$input.first().json; const C=d.CONFIG;\nreturn [{json:{phone:d.user_phone,ownerId:C.OWNER_ID,CONFIG:C,\nnoteText:'تغییر سرعت: '+(d.event?.type||'')+' → '+(d.event?.status||'')}}];\n"
      }
    },
    {
      "id": "create_note",
      "name": "Create Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1300,
        650
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/activity/save?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Activity\":{\"ActivityTypeId\":\"00000000-0000-0000-0000-000000000000\",\"OwnerId\":\"{{$json.ownerId}}\",\"ResultNote\":\"{{$json.noteText}}\",\"IsDone\":true}}",
        "options": {}
      }
    },
    {
      "id": "create_followup",
      "name": "Create Followup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1300,
        900
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://app.didar.me/api/activity/save?apikey={{$json.CONFIG.DIDAR_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"Activity\":{\"Title\":\"{{$json.activityTitle}}\",\"ActivityTypeId\":\"{{$json.activityTypeId}}\",\"OwnerId\":\"{{$json.ownerId}}\",\"IsDone\":false,\"Note\":\"{{$json.activityNote}}\"}}",
        "options": {}
      }
    }
  ],
