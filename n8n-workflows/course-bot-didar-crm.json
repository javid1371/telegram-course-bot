      "parameters": {
        "jsCode": "\nconst prev=$('Prep Register').first().json;\nconst resp=$input.first().json;\nconst found=resp?.Response?.Id||null;\nreturn [{json:{...prev,personExists:!!found,personId:found||null}}];\n",
        "mode": "runOnceForAllItems"
      }
    },
