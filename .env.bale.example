# ========================================
# .env for Bale Bot (Iranian Server)
# ========================================
# Copy this file:  cp .env.bale.example .env
# Then fill in the values below.

# Platform identifier (do NOT change)
PLATFORM=bale

# Bale bot token — get from @botfather on Bale messenger
BOT_TOKEN=YOUR_BALE_BOT_TOKEN_HERE
BOT_USERNAME=your_bale_bot_username

# Admin user IDs on Bale (comma separated)
# Note: Bale user IDs are DIFFERENT from Telegram IDs
ADMIN_USER_IDS=

# Database (local to this server)
DB_NAME=course_bot
DB_USER=bot_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Logging
LOG_LEVEL=INFO

# Webhook secret (for n8n / CRM integration)
WEBHOOK_SECRET=

# Cross-platform sync (optional)
# When internet is available, sync data with Telegram server
# SYNC_PEER_URL=https://your-international-server:8800/sync
# SYNC_SECRET=shared_secret_between_servers
